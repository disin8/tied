---
import DownloadButton from './DownloadButton.astro';
import PhoneMockup from './PhoneMockup.astro';
const tabs = [
  { id: 'home', en: 'Cover', ru: 'Обложка' },
  { id: 'day', en: 'Day', ru: 'День' },
  { id: 'guests', en: 'Guests', ru: 'Гости' },
  { id: 'handoff', en: 'Wedding day', ru: 'В день свадьбы' },
];
const captions = [
  {
    id: 'home',
    titleEn: 'Your names on the cover',
    titleRu: 'Ваши имена на обложке',
    bodyEn: 'Below them: days until the wedding, and numbers like 86 guests, 12 open tasks, and 4 deadlines. This is the first screen you see.',
    bodyRu: 'Под ними дни до свадьбы и числа вроде 86 гостей, 12 открытых дел и 4 срока. Это первый экран при открытии.',
  },
  {
    id: 'day',
    titleEn: 'The schedule by the hour',
    titleRu: 'Программа по часам',
    bodyEn: 'Tap an hour and drag to set how long something lasts. Each item has a place and a person in charge. Outdoor items can store a second time and place for rain.',
    bodyRu: 'Нажмите на час и ведите палец, пока не получится нужная длина. У пункта есть место и ответственный. Для улицы можно сохранить другие время и место на случай дождя.',
  },
  {
    id: 'guests',
    titleEn: 'Who said yes',
    titleRu: 'Кто сказал «да»',
    bodyEn: 'Guests are listed by family, with reply, table, and bride’s or groom’s side. You can mark waiting replies with a swipe.',
    bodyRu: 'Гости идут по семьям: ответ, стол, сторона жениха или невесты. Ответы, которые ещё ждут, можно отметить смахиванием.',
  },
  {
    id: 'handoff',
    titleEn: 'What’s happening now',
    titleRu: 'Что происходит сейчас',
    bodyEn: 'The current item, the next one, and a backup if it rains. You can also send the schedule to another iPhone nearby for the coordinator, without guest phone numbers or allergy notes.',
    bodyRu: 'Текущий пункт, следующий и запасной вариант на дождь. Программу можно отправить на соседний iPhone координатору без телефонов гостей и заметок об аллергии.',
  },
];
---
<section class="px-4 pt-14 md:pt-20 pb-8">
  <div class="mx-auto max-w-3xl text-center">
    <h1 class="text-5xl md:text-6xl leading-[1.02]">
      <span data-lang-en>Guests, money, seating, and the day’s schedule.</span>
      <span data-lang-ru>Гости, деньги, рассадка и порядок дня.</span>
    </h1>
    <p class="mt-5 text-xl text-[var(--ink)] max-w-xl mx-auto">
      <span data-lang-en>See who hasn’t replied, what’s unpaid, and what’s next.</span>
      <span data-lang-ru>Видно, кто не ответил, что не оплачено и что дальше.</span>
    </p>
    <p class="mt-4 text-lg text-[var(--ink-soft)] max-w-xl mx-auto">
      <span data-lang-en>Mark replies with a swipe. Add the Sokolovs as one family with one reply. Each vendor shows how much you paid and how much is left. On the wedding day you see the current item, the next one, and a backup if it rains.</span>
      <span data-lang-ru>Ответы отмечаете смахиванием. Соколовых записываете одной семьёй, с одним ответом. У подрядчика видно, сколько уже заплатили и сколько осталось. В день свадьбы на экране текущий пункт, следующий и запас на дождь.</span>
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <DownloadButton />
      <p class="text-sm text-[var(--ink-soft)]"><span data-lang-en>iPhone · iOS 17+ · English and Russian</span><span data-lang-ru>iPhone · iOS 17+ · русский и английский</span></p>
    </div>
  </div>

  <div id="screens" class="mx-auto mt-12 max-w-5xl">
    <div role="tablist" aria-label="App screens" class="flex flex-wrap justify-center gap-2 mb-8">
      {tabs.map((t, i) => (
        <button type="button" role="tab" data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          class="screen-tab px-4 py-2 rounded-full text-sm font-semibold border border-[var(--border)] bg-white/70 aria-selected:bg-[var(--ink)] aria-selected:text-[var(--bg)] aria-selected:border-transparent">
          <span data-lang-en>{t.en}</span><span data-lang-ru>{t.ru}</span>
        </button>
      ))}
    </div>
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 flex justify-center">
        <PhoneMockup />
      </div>
      <div class="lg:col-span-5">
        {captions.map((c, i) => (
          <article id={`caption-${c.id}`} class="td-card p-6 md:p-8" hidden={i === 0 ? undefined : true}>
            <h2 class="text-3xl leading-tight"><span data-lang-en>{c.titleEn}</span><span data-lang-ru>{c.titleRu}</span></h2>
            <p class="mt-3 text-[var(--ink-soft)] leading-relaxed"><span data-lang-en>{c.bodyEn}</span><span data-lang-ru>{c.bodyRu}</span></p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab]'));
  function select(id: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
      const screen = document.getElementById(`mock-${t.dataset.tab}`);
      if (screen) screen.hidden = !on;
      const caption = document.getElementById(`caption-${t.dataset.tab}`);
      if (caption) caption.hidden = !on;
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      let n = -1;
      if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
      if (n >= 0) { e.preventDefault(); select(tabs[n].dataset.tab!, true); }
    });
  });
</script>
