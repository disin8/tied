---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, DEVELOPER, LEGAL_EFFECTIVE } from '../config';
---
<Layout title="Terms of Use for Tied" description="Terms for the Tied iOS app. It stores the wedding on your iPhone. It does not book the venue, pay vendors, or give legal, tax, or medical advice." path="terms/">
  <article class="px-4 pt-14 pb-10">
    <div class="td-card mx-auto max-w-3xl p-8 md:p-12 prose-legal">
      <h1 class="text-4xl md:text-5xl"><span data-lang-en>Terms of Use for Tied</span><span data-lang-ru>Условия использования Tied</span></h1>
